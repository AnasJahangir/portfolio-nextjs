# Turso (libSQL) — create a free database at https://turso.tech
# The database never sleeps/pauses, unlike Supabase free tier.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin panel (/admin) password — pick a strong one
ADMIN_PASSWORD=choose-a-strong-password
# Optional: separate secret for signing admin session JWTs (defaults to ADMIN_PASSWORD)
# ADMIN_JWT_SECRET=

# Optional: contact-form email notifications (https://resend.com)
# If unset, messages are still saved to the database and the form shows success.
RESEND_API_KEY=
# Email that receives contact-form notifications
CONTACT_TO_EMAIL=anas@anasjahangir.com

# Optional: image uploads in /admin via Vercel Blob
# If unset, the admin can still paste a cover-image URL instead.
BLOB_READ_WRITE_TOKEN=
